{
    "manifest_version": 3,
    "name": "Wisp",
    "version": "1.0.0",
    "description": "Regroupe tes onglets par sujet automatiquement, et endort les groupes inactifs pour libérer la RAM.",
    "homepage_url": "https://wisptab.netlify.app",
    "icons": {
        "16": "icon16.png",
        "32": "icon32.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon16.png",
            "32": "icon32.png",
            "48": "icon48.png",
            "128": "icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "tabs",
        "tabGroups",
        "storage",
        "alarms",
        "contextMenus"
    ]
}
