{
    "manifest_version": 3,
    "name": "__MSG_extName__",
    "version": "1.1.0",
    "description": "__MSG_extDescription__",
    "default_locale": "en",
    "homepage_url": "https://wisptab.com",
    "icons": {
        "16": "icon16.png",
        "32": "icon32.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon16.png",
            "32": "icon32.png",
            "48": "icon48.png",
            "128": "icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "tabs",
        "tabGroups",
        "storage",
        "alarms",
        "contextMenus"
    ]
}
